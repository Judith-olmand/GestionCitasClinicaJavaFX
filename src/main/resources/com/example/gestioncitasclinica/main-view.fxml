<AnchorPane stylesheets="@../../../CSS/estilos.css" prefHeight="702.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.MainController">
